# Copy to .env and fill in. .env is git-ignored — never commit real values.
# In GitHub Actions, add the same names under Settings → Secrets and variables → Actions.

# --- Content table -------------------------------------------------------
# "sheet" (Google Sheet, default for production) or "csv" (local file, for testing)
TABLE_BACKEND=csv
CSV_PATH=data/content.csv
GOOGLE_SHEET_ID=
# Path to the service-account JSON key file (keep it outside the repo or git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternative for CI: the whole JSON key as one string
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Image storage (Cloudflare R2, S3-compatible) -------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=

# --- Meta (Instagram + Facebook) -----------------------------------------
GRAPH_API_VERSION=v23.0
META_PAGE_ID=
IG_USER_ID=
# Long-lived Page access token (see docs/meta-setup-checklist.md)
META_PAGE_ACCESS_TOKEN=

# --- Trends (optional) ----------------------------------------------------
YOUTUBE_API_KEY=

# --- Voice (Phase 2) ------------------------------------------------------
SARVAM_API_KEY=
GOOGLE_TTS_API_KEY=
